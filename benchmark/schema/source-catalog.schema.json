{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpptbench.org/schema/source-catalog.schema.json",
  "title": "Structured source catalog",
  "type": "object",
  "required": ["schema_version", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.4.0-draft"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "platform", "url", "title", "content_type", "accessed_at", "access_status", "supports", "rights"],
        "additionalProperties": false,
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "platform": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string"},
          "author": {"type": ["string", "null"]},
          "published_at": {"type": ["string", "null"], "format": "date"},
          "content_type": {"enum": ["video", "article", "post", "repository", "documentation", "product_page", "other"]},
          "accessed_at": {"type": "string", "format": "date"},
          "access_status": {"enum": ["captured", "partial", "inaccessible", "removed"]},
          "supports": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "evidence_nature": {"enum": ["creator_claim", "vendor_claim", "official_instruction", "repository_metadata", "independent_observation"]},
          "rights": {"enum": ["link_only", "licensed_reuse", "permission_granted", "public_domain", "unknown"]},
          "license": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
